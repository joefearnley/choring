# Copy this file to `.env` and fill in values for production/dev as needed
# Example Supabase DATABASE_URL (Postgres)
# DATABASE_URL=postgresql://<db_user>:<db_pass>@<db_host>:<db_port>/<db_name>

# Django secret key (keep secret in production)
# SECRET_KEY=replace-with-your-secret-key

# Debug flag (True/False)
# DEBUG=False

# Allowed hosts comma-separated
# ALLOWED_HOSTS=yourdomain.com,localhost

# API base (optional) for frontend to call
# API_BASE=https://api.example.com
